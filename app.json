{
  "expo": {
    "name": "Zuneri",
    "slug": "nexo-ia",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/zuneri-logo.png",
    "scheme": "nexoia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amauriciorojas.nexoia"
    },
    "android": {
      "package": "com.amauriciorojas.nexoia",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/zuneri-icon.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/zuneri-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/zuneri-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "dark": {
            "backgroundColor": "#020617"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ba4cde7-ce84-4297-9643-0f2223e021f3"
      }
    }
  }
}
